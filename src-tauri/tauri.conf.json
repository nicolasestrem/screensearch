{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenSearch",
  "version": "0.4.1",
  "identifier": "app.screensearchv2c.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node scripts/stage-mcp.mjs && npm --prefix ui run dev",
    "beforeBuildCommand": "node scripts/stage-mcp.mjs && npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScreenSearch",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "ScreenSearch Overlay",
        "url": "overlay.html",
        "width": 640,
        "height": 460,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "contentProtected": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/frames/**"]
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3RTFDNzczQzBCREY4MUUKUldRZStMM0FjOGZoSi82dnhLWm1rYVlraUxqVUNObU9MYkhVT2M1Ukd4TmY0c0RDZDR1NE1reTEK",
      "endpoints": [
        "https://github.com/nicolasestrem/screensearch-v2c/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/screensearch-mcp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
